---

//interface for a day
interface Day {
	date: string;
	contributionCount: number;
}

//prop needed 
interface Props {
	totalContributions: number;
	weeks: { contributionDays: Day[] }[];
}

//proprs needed in html
const { totalContributions, weeks } = Astro.props;

const max = Math.max(1, ...weeks.flatMap((week) => week.contributionDays.map((day) => day.contributionCount)));

// Five neutral levels, matching the heat-0 to heat-4 tokens in DESIGN.md.
const levelOf = (count: number) => (count === 0 ? 0 : Math.min(4, Math.ceil((count / max) * 4)));

const dayLabel = (date: string) =>
	new Date(`${date}T00:00:00Z`).toLocaleString('en', {
		weekday: 'short',
		month: 'short',
		day: 'numeric',
		year: 'numeric',
		timeZone: 'UTC',
	});

const countLabel = (count: number) => (count === 0 ? 'No contributions' : `${count} contribution${count === 1 ? '' : 's'}`);

// Each cell sits in its own grid column (week) and row (weekday). Row 1 holds the month labels.
const cells = weeks.flatMap((week, x) =>
	week.contributionDays.map((day, y) => ({
		column: x + 1,
		row: y + 2,
		level: levelOf(day.contributionCount),
		tip: `${countLabel(day.contributionCount)} on ${dayLabel(day.date)}`,
	})),
);

const monthLabels: { column: number; name: string }[] = [];
let previousMonth = '';

weeks.forEach((week, x) => {
	const first = week.contributionDays[0];
	if (first) {
		const month = first.date.slice(0, 7);
		if (month !== previousMonth) {
			const name = new Date(`${first.date}T00:00:00Z`).toLocaleString('en', { month: 'short', timeZone: 'UTC' });
			monthLabels.push({ column: x + 1, name });
			previousMonth = month;
		}
	}
});

// A label needs about 3 week columns of room. Drop any month that starts less than 3 weeks before
// the next one, usually the partial month at the left edge, so labels never run together ("OctNov").
const MIN_LABEL_COLUMNS = 3;
const visibleMonthLabels = monthLabels.filter(
	(label, i) => i === monthLabels.length - 1 || monthLabels[i + 1].column - label.column >= MIN_LABEL_COLUMNS,
);
---

<figure class="heatmap">
	<div class="grid" style={`--weeks: ${weeks.length};`}>
		{visibleMonthLabels.map((label) => (
			<span class="month" style={`grid-column: ${label.column}; grid-row: 1;`}>{label.name}</span>
		))}
		{
			cells.map((cell) => (
				<span class={`day heat-${cell.level}`} style={`grid-column: ${cell.column}; grid-row: ${cell.row};`}>
					<span class="tip" role="tooltip">{cell.tip}</span>
				</span>
			))
		}
	</div>
	<figcaption>
		<p>{totalContributions} contributions in the last year.</p>
		<p class="legend">
			<span>Less</span>
			{[0, 1, 2, 3, 4].map((level) => (
				<span class={`swatch heat-${level}`} aria-hidden="true"></span>
			))}
			<span>More</span>
		</p>
	</figcaption>
</figure>

<style>
	.heatmap {
		margin: 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
		grid-template-rows: auto repeat(7, 1fr);
		gap: 2px;
	}

	.month {
		font-size: 15px;
		line-height: 1.2;
		color: var(--charcoal);
		white-space: nowrap;
	}

	.day {
		position: relative;
		aspect-ratio: 1;
		outline: 1px solid transparent;
		outline-offset: 0;
	}

	/* Hover outline, the same signal GitHub gives on a day. */
	.day:hover {
		outline-color: var(--ink);
	}

	/* Custom tooltip, styled like shadcn's: dark box, small arrow, no delay. Rendered in CSS, so no JavaScript. */
	.tip {
		display: none;
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		transform: translateX(-50%);
		z-index: 10;
		padding: var(--space-5) var(--space-10);
		background: var(--ink);
		color: var(--paper);
		font-size: 15px;
		line-height: 1.2;
		white-space: nowrap;
		pointer-events: none;
	}

	.tip::after {
		content: "";
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		border: 5px solid transparent;
		border-top-color: var(--ink);
	}

	.day:hover > .tip {
		display: block;
	}

	.heat-0 {
		background: var(--heat-0);
	}
	.heat-1 {
		background: var(--heat-1);
	}
	.heat-2 {
		background: var(--heat-2);
	}
	.heat-3 {
		background: var(--heat-3);
	}
	.heat-4 {
		background: var(--heat-4);
	}

	figcaption {
		margin-top: var(--space-21);
		font-size: 15px;
		color: var(--charcoal);
	}

	figcaption p + p {
		margin-top: var(--space-10);
	}

	.legend {
		display: flex;
		align-items: center;
		gap: var(--space-5);
	}

	.swatch {
		display: inline-block;
		width: 12px;
		height: 12px;
	}

	/* Wide screens: fixed 10px cells, as on GitHub. Narrow screens: cells share the width. */
	@media (min-width: 48rem) {
		.grid {
			grid-template-columns: repeat(var(--weeks), 10px);
			grid-template-rows: auto repeat(7, 10px);
			width: max-content;
		}
	}
</style>
