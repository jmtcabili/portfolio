---
import '../styles/global.css';

const { title } = Astro.props;

// The index nav mirrors the section order on the home page. Projects is left out until /projects/ exists.
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/#about', label: 'About' },
	{ href: '/#experience', label: 'Experience' },
	{ href: '/#stack', label: 'Stack' },
	{ href: '/#github', label: 'GitHub' },
	{ href: '/#contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/major-mono-display-latin.woff2" as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="container">
			<header class="site-header">
				<a class="wordmark" href="/">jmt_</a>
				<nav class="index-nav" aria-label="Primary">
					<ul>
						{navItems.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={item.href === '/' && Astro.url.pathname === '/' ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</header>
			<main id="main">
				<slot />
			</main>
			<footer class="site-footer">
				<p>© {new Date().getFullYear()} Johan Marlo Cabili</p>
				<p>
					<a href="mailto:jmtcabili@gmail.com">Email jmtcabili@gmail.com</a>
					·
					<a href="https://github.com/jmtcabili">GitHub jmtcabili</a>
				</p>
			</footer>
		</div>
	</body>
</html>
